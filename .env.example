# SQL Server Connection (using Windows Authentication)
SQL_SERVER=your_server_name
SQL_DATABASE=msdb

# Network Drive Path
NETWORK_DRIVE_ROOT=\\\\networkdrive\\sql_files

# Application Settings
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=False

# Note: Email notifications are handled by SQL Server Agent using Database Mail
# See README for Database Mail configuration instructions
