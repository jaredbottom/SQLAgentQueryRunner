[Unit]
Description=SQL Agent Query Runner Web Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/SQLAgentQueryRunner
Environment="PATH=/opt/SQLAgentQueryRunner/venv/bin"
ExecStart=/opt/SQLAgentQueryRunner/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
